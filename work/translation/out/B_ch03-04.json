{
 "DT_Chapter_03|MissionObjectives|Title_A": "스타리 브라트섬의 미 공군 기지로 향하라",
 "DT_Chapter_03|MissionObjectives|M_00": "적의 대공 병기를 무력화하라",
 "DT_Chapter_03|MissionObjectives|M_01": "적 차량을 파괴하라",
 "DT_Chapter_03|MissionObjectives|Title_B": "스타리 브라트섬 미 공군 기지를 탈환하라",
 "DT_Chapter_03|MissionObjectives|M_03": "공항 안의 적 부대를 소탕하라",
 "DT_Chapter_03|MissionObjectives|M_04": "게이트를 열어라",
 "DT_Chapter_03|MissionObjectives|M_05": "문이 열릴 때까지 버텨라",
 "DT_Chapter_03|MissionObjectives|M_06": "구역을 빠져나가라",
 "DT_Chapter_03|MissionObjectives|M_07": "연료 탱크 근처의 적을 소탕하라",
 "DT_Chapter_03|MissionObjectives|M_08": "적 정예 부대를 섬멸하라",
 "DT_Chapter_03|MissionObjectives|M_09": "구역을 재빨리 빠져나가라",
 "DT_Chapter_03|MissionObjectives|M_10": "격납고 안의 적을 소탕하라",
 "DT_Chapter_03|MissionObjectives|M_11": "샤하와 대결하라",
 "DT_Chapter_03|MissionObjectives|M_12": "적 부대를 소탕하라",
 "DT_Chapter_03|Settings|Title": "극동 신공화국",
 "DT_Chapter_03|Subs_C010|L_001": "상황은 갈수록 나빠지고 있다.\n미군은 본토 방어에 묶여서 한 발짝도 못 나간다.\n게다가 수에즈와 파나마 운하가 둘 다 부서져서\n우리 함대는 손발이 묶였지.",
 "DT_Chapter_03|Subs_C010|L_002": "적이 바닷길 무역로를 막으면 전 세계에 식량 위기가 닥치고\n혁명이니 무정부 상태니 난리가 날 거다.\n각국 지도자들과 연락이 닿아야 한다.",
 "DT_Chapter_03|Subs_C010|L_003": "C4한테 박아 둔 비컨탄이 살아 있으면\n녀석들 위치를 알 수 있어.",
 "DT_Chapter_03|Subs_C010|L_004": "이미 신호 추적 중이야.\n브라트 경제특구로 향하는 것 같아.",
 "DT_Chapter_03|Subs_C010|L_005": "‘미일러 안전 보장 조약’이 맺어진 뒤로\n그곳은 한창 재개발 중이다.\n하지만 첩보 위성이 없으니 자세한 상황은 알 수가 없지.",
 "DT_Chapter_03|Subs_C010|L_006": "제 부대를 내려 주십시오.\n어떻게든 해내겠습니다.",
 "DT_Chapter_03|Subs_C010|L_007": "너희는 아이반과 함께 우선 스타리 브라트섬의\n미군 기지에서 작전을 개시한다.\n이상이다.",
 "DT_Chapter_03|Subs_C020|L_001": "또 파나마 때처럼\n혼자 영웅 놀이 하다간\n“낙오자 한 명”은 네가 될 거다.\n알아들었나?",
 "DT_Chapter_03|Subs_C020|L_002": "방금 신호가 끊겼어.",
 "DT_Chapter_03|Subs_C020|L_003": "적이 비컨탄을 찾아낸 모양이야.",
 "DT_Chapter_03|Subs_C022|L_000": "지대공 미사일 접근!",
 "DT_Chapter_03|Subs_C022|L_001": "플레어 방출!",
 "DT_Chapter_03|Subs_C030|L_001": "엔진 하나 나갔어!\n경착륙에 대비해!",
 "DT_Chapter_03|Subs_C030|L_002": "우리가 적을 끌어낸다!\n러시아인은 제자리를 지키게 해!",
 "DT_Chapter_03|Subs_C035|L_001": "적을 막아. 알겠나?",
 "DT_Chapter_03|Subs_C040|L_001": "대위, 나한텐 내 방식이 있어.\n하지만 당신들한테도 당신들 임무가 있다는 건 알아.\n사냥 시간이다.",
 "DT_Chapter_03|Subs_C042|L_001": "기다려, 아이반!",
 "DT_Chapter_03|Subs_C044|L_002": "젠장!",
 "DT_Chapter_03|Subs_C050|L_002": "대위님, 아직 살아 있습니다!",
 "DT_Chapter_03|Subs_C050|L_003": "조심해! 폭탄을 달고 있을지도 몰라!",
 "DT_Chapter_03|Subs_C050|L_004": "닉!",
 "DT_Chapter_03|Subs_C050|L_006": "어이. 어이!",
 "DT_Chapter_03|Subs_C050|L_007": "바비큐는 처음이냐?",
 "DT_Chapter_03|Subs_C050|L_008": "다음엔 우리 다 죽이기 전에 생각 좀 해라.",
 "DT_Chapter_03|Subs_C050|L_009": "죄송합니다, 대위님.",
 "DT_Chapter_03|Subs_C050|L_010": "배신자…",
 "DT_Chapter_03|Subs_C070|L_001": "그게 지금 네 모습이냐, 아이반?",
 "DT_Chapter_03|Subs_C070|L_002": "네 손으로 싸우라고 가르쳤건만…",
 "DT_Chapter_03|Subs_C070|L_003": "그런데 나타난 건 한낱 총잡이.\n영혼 없는 살인자라니.",
 "DT_Chapter_03|Subs_C070|L_004": "네 부자 주인들은\n아프리카·아시아의 가난한 이들에게 “원조”를 내밀고",
 "DT_Chapter_03|Subs_C070|L_005": "자원을 빼앗아 간다.",
 "DT_Chapter_03|Subs_C070|L_006": "사람들의 고통이 보이지 않느냐?",
 "DT_Chapter_03|Subs_C070|L_007": "너는…",
 "DT_Chapter_03|Subs_C070|L_009": "너에겐 굶주린 이들의 비명이 들리지 않느냐?",
 "DT_Chapter_03|Subs_C080|L_001": "아이반, 난 여기 남아서 무인 공격기로 지원할게.\n근데 위성이 먹통이라 범위가 좁아…",
 "DT_Chapter_03|Subs_C080|L_002": "……브라트 시……한가…데……중앙 병…에\n……SOD……시…설이……지하…숨겨……",
 "DT_Chapter_03|Subs_C080|L_003": "……찾…………거기서…아이반……",
 "DT_Chapter_03|Subs_C080|L_004": "아이반, 방금 그거 들었어?",
 "DT_Chapter_03|Subs_C080|L_005": "들었어.",
 "DT_Chapter_03|Subs_C080|L_006": "대체 뭐였지?",
 "DT_Chapter_03|Subs_C110|L_002": "젠장!",
 "DT_Chapter_03|Subs_C110|L_003": "갇혔다!",
 "DT_Chapter_03|Subs_C110|L_004": "뛰어!",
 "DT_Chapter_03|Subs_R000|L_001": "저게 뭐야!?",
 "DT_Chapter_03|Subs_R000|L_002": "이게 말이 돼!?",
 "DT_Chapter_03|Subs_R000|L_003": "먹히긴 하는 거야?",
 "DT_Chapter_03|Subs_R000|L_004": "이 녀석, 막을 수가 없어!",
 "DT_Chapter_03|Subs_R000|L_005": "또 온다!",
 "DT_Chapter_03|Subs_R000|L_006": "이 새끼 이제 지긋지긋해!",
 "DT_Chapter_03|Subs_R000|L_007": "젠장, 이제 질린다!",
 "DT_Chapter_03|Subs_R000|L_008": "또 저 녀석이야!?",
 "DT_Chapter_03|Subs_R000|L_009": "세게 몰아쳐!",
 "DT_Chapter_03|Subs_R000|L_010": "이 녀석들 장난 아니야!",
 "DT_Chapter_03|Subs_R000|L_011": "이 녀석들 만만치 않아!",
 "DT_Chapter_03|Subs_R000|L_012": "저건 대체 뭐야!?",
 "DT_Chapter_03|Subs_R000|L_013": "이 녀석, 제법인데!",
 "DT_Chapter_03|Subs_R000|L_014": "수류탄!",
 "DT_Chapter_03|Subs_R000|L_015": "수류탄!",
 "DT_Chapter_03|Subs_R010|L_001": "이 기지는 극동 미 공군 작전의 핵심이야.\n적을 소탕하고 서둘러 기지를 확보하라는 명령이야.",
 "DT_Chapter_03|Subs_R010|L_002": "알겠습니다, 소령님.",
 "DT_Chapter_03|Subs_R010|L_003": "여기 피해가 심하군.",
 "DT_Chapter_03|Subs_R010|L_004": "뭐, 그래도 음료는 차갑게 해 뒀네.",
 "DT_Chapter_03|Subs_R010|L_005": "전자파를 막은 자가발전기가 따로 있겠지.\n공군의 최우선 과제… 맥주는 차갑게.",
 "DT_Chapter_03|Subs_R020|L_001": "내 신호에 맞춰…",
 "DT_Chapter_03|Subs_R020|L_002": "움직여!",
 "DT_Chapter_03|Subs_R020|L_003": "잡담 금지.",
 "DT_Chapter_03|Subs_R020|L_004": "엄폐해!",
 "DT_Chapter_03|Subs_R020|L_005": "온다!",
 "DT_Chapter_03|Subs_R020|L_006": "위다! 2층에 있다.",
 "DT_Chapter_03|Subs_R020|L_007": "머리 숙여!",
 "DT_Chapter_03|Subs_R020|L_008": "짐, 오른쪽으로 돌아.",
 "DT_Chapter_03|Subs_R020|L_009": "조금 물러서!",
 "DT_Chapter_03|Subs_R020|L_010": "적 확인.",
 "DT_Chapter_03|Subs_R020|L_011": "조심해.",
 "DT_Chapter_03|Subs_R020|L_012": "좋아, 가! 가! 가!",
 "DT_Chapter_03|Subs_R020|L_013": "거참, 친절한 환영이군.",
 "DT_Chapter_03|Subs_R030|L_001": "생존자를 확인해.",
 "DT_Chapter_03|Subs_R030|L_002": "가망 없어.",
 "DT_Chapter_03|Subs_R030|L_003": "살아 있는 사람… 아무도 없나?",
 "DT_Chapter_03|Subs_R040|L_001": "젠장! 우리 편 장갑차랑 싸워야 해?",
 "DT_Chapter_03|Subs_R040|L_002": "산개해!",
 "DT_Chapter_03|Subs_R040|L_003": "흩어져서 적의 사격을 분산시켜!",
 "DT_Chapter_03|Subs_R040|L_004": "사수를 노려!",
 "DT_Chapter_03|Subs_R040|L_005": "누가 저 녀석 좀 잡아.",
 "DT_Chapter_03|Subs_R040|L_006": "돌파한다!",
 "DT_Chapter_03|Subs_R040|L_007": "가자.",
 "DT_Chapter_03|Subs_R040|L_008": "가! 가! 가! 가!",
 "DT_Chapter_03|Subs_R050|L_003": "부상자 있나?",
 "DT_Chapter_03|Subs_R050|L_004": "아직 끝난 게 아니다.\n조심해서 전진해.",
 "DT_Chapter_03|Subs_R060|L_001": "빌!",
 "DT_Chapter_03|Subs_R060|L_002": "빌어먹을!",
 "DT_Chapter_03|Subs_R060|L_003": "뒤를 조심해!",
 "DT_Chapter_03|Subs_R060|L_004": "워우!\n흔한 SOD 졸병들이 아니야.",
 "DT_Chapter_03|Subs_R060|L_005": "조심해, 이 녀석들 빠르다!",
 "DT_Chapter_03|Subs_R060|L_006": "게이트를 여는 스위치가 있을 거다.\n찾아!",
 "DT_Chapter_03|Subs_R060|L_007": "저 움직임, 특수부대인가?",
 "DT_Chapter_03|Subs_R060|L_008": "적이다!",
 "DT_Chapter_03|Subs_R060|L_009": "젠장, 빌이 당했어.",
 "DT_Chapter_03|Subs_R060|L_010": "애도는 나중이다…\n움직여!",
 "DT_Chapter_03|Subs_R060|L_011": "아이반, 가자!",
 "DT_Chapter_03|Subs_R060|L_012": "아이반, 먼저 간다.",
 "DT_Chapter_03|Subs_R070|L_001": "젠장, 코드 잠금이다.\n샘, 풀 수 있겠나?",
 "DT_Chapter_03|Subs_R070|L_002": "바로 하겠습니다.",
 "DT_Chapter_03|Subs_R070|L_003": "나머지는 후방을 경계해.",
 "DT_Chapter_03|Subs_R070|L_004": "적이 온다!",
 "DT_Chapter_03|Subs_R070|L_005": "빌어먹을, 공병을 지켜!",
 "DT_Chapter_03|Subs_R080|L_001": "막아 내!",
 "DT_Chapter_03|Subs_R080|L_002": "진지를 사수해!",
 "DT_Chapter_03|Subs_R080|L_003": "적이 뒤에 붙었다!",
 "DT_Chapter_03|Subs_R080|L_004": "샘?",
 "DT_Chapter_03|Subs_R080|L_005": "거의 다 됐습니다.",
 "DT_Chapter_03|Subs_R080|L_006": "서둘러!",
 "DT_Chapter_03|Subs_R080|L_007": "됐습니다!",
 "DT_Chapter_03|Subs_R080|L_008": "가자.",
 "DT_Chapter_03|Subs_R090|L_001": "젠장, 이제 지겹다.",
 "DT_Chapter_03|Subs_R090|L_002": "씨발, 무슨 바퀴벌레 떼야!",
 "DT_Chapter_03|Subs_R090|L_003": "눈 똑바로 떠.",
 "DT_Chapter_03|Subs_R100|L_001": "엘리베이터로 간다.",
 "DT_Chapter_03|Subs_R100|L_002": "NATO 탄창 찾았다!",
 "DT_Chapter_03|Subs_R100|L_003": "좋아, 한 발도 안 남기고 다 쏴 주지.",
 "DT_Chapter_03|Subs_R100|L_004": "설마 이 안엔 없겠지.",
 "DT_Chapter_03|Subs_R100|L_005": "그런 말 하면 꼭 나오더라.",
 "DT_Chapter_03|Subs_R100|L_006": "클리어!",
 "DT_Chapter_03|Subs_R110|L_001": "아이반, 먼저 가. 우리도 곧 따라간다.",
 "DT_Chapter_03|Subs_R110|L_002": "아이반, 들려?",
 "DT_Chapter_03|Subs_R110|L_003": "선글라스를 적외선 모드로 바꿔.\n그러면 폭탄이 보일 거야.",
 "DT_Chapter_03|Subs_R110|L_004": "그 폭탄엔 근접 센서가 있어.\n안전한 거리에서 쏴.",
 "DT_Chapter_03|Subs_R110|L_005": "닉, 정신 차려!",
 "DT_Chapter_03|Subs_R110|L_006": "무슨 개수작이야!",
 "DT_Chapter_03|Subs_R120|L_001": "아이반, 창고를 지나 사무실 건물을 통과해.\n연료 저장소에 닿으면 가로질러서 주차장으로 가.\n알파 팀이 거기서 합류할 거야.",
 "DT_Chapter_03|Subs_R120|L_002": "먼저 가! 거기서 합류한다.",
 "DT_Chapter_03|Subs_R120|L_003": "거의 다 왔다.\n그 길로 쭉 가면 큰 주차장이 나와.\n우린 거기 있어.",
 "DT_Chapter_03|Subs_R130|L_001": "매복이다!",
 "DT_Chapter_03|Subs_R130|L_002": "주차 구역에서 적과 교전 중!\n델타, 집결하라!",
 "DT_Chapter_03|Subs_R130|L_003": "여기도 공격받고 있습니다!\n돌파하는 대로 지원하겠습니다!",
 "DT_Chapter_03|Subs_R130|L_004": "아이반, 서둘러!",
 "DT_Chapter_03|Subs_R140|L_001": "늦었잖아.\n보드카라도 원샷하고 왔냐?",
 "DT_Chapter_03|Subs_R140|L_002": "어이… 안 취했으면 좀 도와줘.",
 "DT_Chapter_03|Subs_R140|L_003": "빨갱이가 아니라 겁쟁이인 줄 알았잖아.",
 "DT_Chapter_03|Subs_R140|L_004": "지금쯤 크렘린 가는 길인 줄 알았지.",
 "DT_Chapter_03|Subs_R140|L_005": "파티에 끼라고, 동무!",
 "DT_Chapter_03|Subs_R140|L_007": "앞 건물 2층!",
 "DT_Chapter_03|Subs_R140|L_008": "누가 저 녀석 좀 처리해!",
 "DT_Chapter_03|Subs_R140|L_009": "해치웠어.",
 "DT_Chapter_03|Subs_R140|L_010": "제기랄! 사방에 깔렸어!",
 "DT_Chapter_03|Subs_R140|L_011": "탄약 좀 줘!",
 "DT_Chapter_03|Subs_R140|L_012": "휘유, 제법인데.",
 "DT_Chapter_03|Subs_R140|L_013": "씨발, 이 녀석들 대체 어디 숨어 있었던 거야?",
 "DT_Chapter_03|Subs_R140|L_014": "누군지 몰라도 사람 하나는 잘 모으네!",
 "DT_Chapter_03|Subs_R140|L_015": "이러다간 다 튀겨지겠어!",
 "DT_Chapter_03|Subs_R140|L_016": "젠장, 뚫고 갈 수가 없어!",
 "DT_Chapter_03|Subs_R140|L_017": "활주로가 막혔어!",
 "DT_Chapter_03|Subs_R140|L_018": "장갑차는 정리했다. 움직여!",
 "DT_Chapter_03|Subs_R140|L_019": "가! 가! 가!",
 "DT_Chapter_03|Subs_R150|L_005": "뛰어들어!",
 "DT_Chapter_03|Subs_R160|L_002": "괜찮나?",
 "DT_Chapter_03|Subs_R160|L_003": "이상 없습니다!",
 "DT_Chapter_03|Subs_R160|L_004": "좋아.\n함정 조심해.",
 "DT_Chapter_03|Subs_R170|L_001": "올 클리어.",
 "DT_Chapter_03|Subs_R170|L_002": "어디서 이렇게 기어 나와!",
 "DT_Chapter_03|Subs_R170|L_003": "씨발, 흰개미 떼도 아니고!",
 "DT_Chapter_03|Subs_R170|L_004": "너무 많다, 흩어져!",
 "DT_Chapter_03|Subs_R170|L_005": "조심해. 매복하기 좋은 곳이다.",
 "DT_Chapter_03|Subs_R170|L_006": "아이반, 거기서 엄호해 줘.",
 "DT_Chapter_03|Subs_R170|L_007": "이 자식이, 까불지 마라!",
 "DT_Chapter_03|Subs_R170|L_008": "탄약 챙겨!",
 "DT_Chapter_03|Subs_R170|L_009": "올 클리어.",
 "DT_Chapter_03|Subs_R170|L_010": "금방 끝났네.",
 "DT_Chapter_03|Subs_R180|L_001": "여기는 팀 찰리.\n활주로의 적이 퇴각 중이다.",
 "DT_Chapter_03|Subs_R180|L_002": "하지만 피해가 심해서 활주로는 못 쓴다.",
 "DT_Chapter_03|Subs_R180|L_003": "델타, 상황 어때?",
 "DT_Chapter_03|Subs_R180|L_004": "이상 없습니다.\n격납고를 확보한 뒤 귀환하겠습니다.",
 "DT_Chapter_03|Subs_R180|L_005": "알았어.\n너무 멀리까진 쫓지 마.",
 "DT_Chapter_03|Subs_R190|L_001": "아는 녀석인가?\n나머지는 내가 맡는다!",
 "DT_Chapter_03|Subs_R190|L_002": "빨리 끝내, 아이반!",
 "DT_Chapter_03|Subs_R190|L_003": "어이, 빨리 좀 끝내 줄래?",
 "DT_Chapter_03|Subs_R200|L_001": "적이다!",
 "DT_Chapter_03|Subs_R200|L_002": "총이 안 먹힌다!",
 "DT_Chapter_03|Subs_R200|L_003": "이 녀석들 방탄 방패를 갖고 있어! 짜증 나게!",
 "DT_Chapter_03|Subs_R200|L_004": "이 망할 놈들, 내가 쓸어 주마!",
 "DT_Chapter_03|Subs_R200|L_005": "저런 방패는 처음 봐.\n레늄이 틀림없어!",
 "DT_Chapter_03|Subs_R200|L_006": "공격할 때는 방패를 내린다.\n그때가 기회다!",
 "DT_Chapter_03|Subs_R200|L_007": "저 망할 방패!",
 "DT_Chapter_03|Telops|Chapter3Time_a": "현지 시간 11월 7일 21:30",
 "DT_Chapter_03|Telops|Chapter3Place_a": "북태평양",
 "DT_Chapter_03|Telops|Chapter3Time_b": "현지 시간 11월 8일 14:51",
 "DT_Chapter_03|Telops|Chapter3Place_b": "스타리 브라트섬\n브라트 북부 공군 기지",
 "DT_Chapter_03_Mg1|Subs_Set01|L_001": "잘했어, 아이반!",
 "DT_Chapter_03_Mg1|Subs_Set01|L_002": "일단 교전 구역을 벗어났습니다.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_003": "관제탑엔 연결되나?",
 "DT_Chapter_03_Mg1|Subs_Set01|L_004": "브라트 공군 기지, 여기는 델타 베이스.\n브라트, 응답하라.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_005": "응답 없습니다.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_006": "이미 점령당했나 보군.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_007": "케슬러 증후군 때문에 레이더는 먹통입니다.\n돌아갈까요?",
 "DT_Chapter_03_Mg1|Subs_Set01|L_008": "어림없지. 낮게 날며 뭐가 나오나 정찰한다.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_009": "적도 레이더를 못 씁니다.\n저공으로 진입하겠습니다.\n녀석들이 이 기체를 볼 때쯤엔 우리 공격에 한창 불타고 있을 겁니다.",
 "DT_Chapter_03_Mg1|Subs_Set01|L_010": "델타 팀, 스탠바이.\n불구덩이로 뛰어든다!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_001": "전방 12시 방향에 열원 탐지!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_002": "전방 9시 방향에 열원 탐지!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_003": "전방 3시 방향에 열원 탐지!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_004": "전방 12시 방향에 기체 확인!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_005": "전방 9시 방향에 기체 확인!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_006": "전방 3시 방향에 기체 확인!",
 "DT_Chapter_03_Mg1|Subs_Set02|L_007": "온다! 꽉 잡아.",
 "DT_Chapter_03_Mg1|Subs_Set03|L_001": "건물은 쏘지 마.\n안에 아군이 있을지도 몰라!",
 "DT_Chapter_03_Mg1|Subs_Set03|L_002": "저 활주로는 새로 깔아야겠군.",
 "DT_Chapter_03_Mg1|Subs_Set03|L_003": "탄은 넉넉하다. 마음껏 갈겨!",
 "DT_Chapter_03_Mg1|Subs_Set03|L_004": "트럭 컨테이너를 노려!\n맞히면 폭발할 거야.",
 "DT_Chapter_03_Mg1|Subs_Set03|L_006": "곧 내릴 수 있다.\n하지만 거친 착륙이 될 거다.",
 "DT_Chapter_03_Mg1|Subs_Set04|L_001": "눈썰미 좋네, 죄수 양반!",
 "DT_Chapter_03_Mg1|Subs_Set04|L_002": "착착 해치우는데.",
 "DT_Chapter_03_Mg1|Subs_Set04|L_003": "좋아, 다음으로!",
 "DT_Chapter_03_Mg1|Subs_Set05|L_002": "꽉 잡아.",
 "DT_Chapter_03_Mg1|Subs_Set05|L_003": "피해를 확인해.",
 "DT_Chapter_03_Mg1|Subs_Set05|L_004": "버텨.",
 "DT_Chapter_03_Mg1|Subs_Set05|L_005": "조준 단단히 해!",
 "DT_Chapter_03_Mg1|Subs_Set05|L_006": "탄은 충분하다. 다 쏟아부어!",
 "DT_Chapter_03_Mg1|Subs_Set06|L_001": "꼬리 날개 파손!\n더 맞으면 못 버팁니다!",
 "DT_Chapter_03_Mg1|Subs_Set06|L_002": "더는 못 버텨!",
 "DT_Chapter_03_Mg1|Subs_Set06|L_003": "이런 젠장!",
 "DT_Chapter_03_Mg1|Subs_Set06|L_004": "씨발!",
 "DT_Chapter_03_Mg2|Subs_Set01|L_001": "산개해서 각자 적의 주의를 끌어!",
 "DT_Chapter_03_Mg2|Subs_Set01|L_002": "젠장, 대체 몇이나 되는 거야!?",
 "DT_Chapter_03_Mg2|Subs_Set01|L_003": "중요한 건\n적을 몇이나 길동무로 데려가느냐다!",
 "DT_Chapter_03_Mg2|Subs_Set02|L_001": "찰리, 괜찮나?",
 "DT_Chapter_03_Mg2|Subs_Set02|L_002": "탄약이 얼마 없습니다!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_001": "저 LAV를 잡아!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_002": "토미, 들리나? 젠장.",
 "DT_Chapter_03_Mg2|Subs_Set03|L_003": "LAV라고?\n저걸 어디서 구한 거야!?",
 "DT_Chapter_03_Mg2|Subs_Set03|L_004": "몰려온다!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_005": "12시 방향에 적 증원. LAV다!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_006": "9시 방향에 적 증원. LAV다!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_007": "3시 방향에 적 증원. LAV다!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_008": "아이반, 델타 장비로는 상대가 안 돼!\n적 장갑차를 무력화해!",
 "DT_Chapter_03_Mg2|Subs_Set03|L_009": "델타를 엄호하고 적 차량을 박살 내!",
 "DT_Chapter_03_Mg2|Subs_Set04|L_001": "잘하고 있어!",
 "DT_Chapter_03_Mg2|Subs_Set04|L_002": "폭발 반경에 휘말리지 마!",
 "DT_Chapter_03_Mg2|Subs_Set04|L_003": "델타 리더, 들려?\n대위?",
 "DT_Chapter_03_Mg2|Subs_Set04|L_004": "응답이 없어… 밥!",
 "DT_Chapter_04|MissionObjectives|Title": "브라트 중앙 병원을 탐색하라",
 "DT_Chapter_04|MissionObjectives|M_00": "역 앞 광장으로 가라",
 "DT_Chapter_04|MissionObjectives|M_01": "무너진 교회로 들어가라",
 "DT_Chapter_04|MissionObjectives|M_02": "광장의 적 부대를 소탕하라",
 "DT_Chapter_04|MissionObjectives|M_03": "적 전차를 파괴하라",
 "DT_Chapter_04|MissionObjectives|M_04": "호텔 안으로 대피하라",
 "DT_Chapter_04|MissionObjectives|M_05": "정체불명의 생존자를 쫓아라",
 "DT_Chapter_04|MissionObjectives|M_06": "맞은편 다리 위의 적 부대를 섬멸하라",
 "DT_Chapter_04|MissionObjectives|M_07": "구멍 안으로 내려가라",
 "DT_Chapter_04|MissionObjectives|M_08": "지하 시설 안을 탐색하라",
 "DT_Chapter_04|MissionObjectives|M_09": "브라트 중앙 병원 안으로 침입하라",
 "DT_Chapter_04|MissionObjectives|M_10": "병원 안을 탐색하라",
 "DT_Chapter_04|MissionObjectives|M_11": "예비 발전기를 찾아라",
 "DT_Chapter_04|MissionObjectives|M_12": "병원 지하로 들어가라",
 "DT_Chapter_04|MissionObjectives|M_13": "적 보스를 무력화하라",
 "DT_Chapter_04|Settings|Title": "제정 러시아의 잔재",
 "DT_Chapter_04|Subs_C010|L_001": "아이반, 들려?\n무인 공격기는 전술 데이터 링크까지 다 살아 있어.",
 "DT_Chapter_04|Subs_C010|L_002": "아까 끼어든 통신 말인데\nC4는 상업 지구 중앙 병원 얘기를 하려던 것 같아.\nSOD는 그 구역을 통째로 봉쇄 중이야.",
 "DT_Chapter_04|Subs_C010|L_003": "함정 냄새가 나.",
 "DT_Chapter_04|Subs_C010|L_004": "그래.\n하지만 피해 가면 아무것도 못 잡아.",
 "DT_Chapter_04|Subs_C010|L_005": "적 접근 중!\n교전에 대비해!",
 "DT_Chapter_04|Subs_C015|L_001": "엄폐해!",
 "DT_Chapter_04|Subs_C015|L_002": "기다려!",
 "DT_Chapter_04|Subs_C015|L_003": "전방 경계!",
 "DT_Chapter_04|Subs_C015|L_004": "거기서 대기!",
 "DT_Chapter_04|Subs_C015|L_005": "전원 그 자리에서 움직이지 마!",
 "DT_Chapter_04|Subs_C015|L_006": "이제 위치가 드러났다. 조준해.",
 "DT_Chapter_04|Subs_C015|L_007": "쏴라!",
 "DT_Chapter_04|Subs_C020|L_001": "이건 대체 뭐야?",
 "DT_Chapter_04|Subs_C020|L_002": "개자식들.",
 "DT_Chapter_04|Subs_C020|L_003": "조심해! 살아 있다! 죽여!",
 "DT_Chapter_04|Subs_C020|L_004": "엄호해 줘. 들어간다.",
 "DT_Chapter_04|Subs_C020|L_005": "그러지.",
 "DT_Chapter_04|Subs_C021|L_001": "젠장, 갈수록 태산이군.",
 "DT_Chapter_04|Subs_C022|L_002": "아이반, 움직여!",
 "DT_Chapter_04|Subs_C023|L_001": "적 증원이다!",
 "DT_Chapter_04|Subs_C023|L_002": "박살 내!",
 "DT_Chapter_04|Subs_C025|L_001": "서둘러!\n폭약 설치! 봉쇄해!",
 "DT_Chapter_04|Subs_C025|L_002": "위다!",
 "DT_Chapter_04|Subs_C029|L_001": "호텔에서 나가! 서둘러!",
 "DT_Chapter_04|Subs_C029|L_002": "뛰어!",
 "DT_Chapter_04|Subs_C030|L_001": "멈춰!",
 "DT_Chapter_04|Subs_C030|L_003": "민간인이다! 사격 중지!",
 "DT_Chapter_04|Subs_C030|L_004": "어이, 기다려!",
 "DT_Chapter_04|Subs_C040|L_002": "진정해. 해치려는 거 아냐.",
 "DT_Chapter_04|Subs_C040|L_003": "어이.",
 "DT_Chapter_04|Subs_C042|L_001": "뭔진 몰라도 사람은 아니야.",
 "DT_Chapter_04|Subs_C042|L_002": "소령님, 분석할 이미지를 보내겠습니다.",
 "DT_Chapter_04|Subs_C050|L_001": "앞쪽 장갑차는 내가 처리할게.\n아이반, 글라스 디바이스로 목표를 록온해!",
 "DT_Chapter_04|Subs_C060|L_001": "중앙 병원은 바로 앞이야.",
 "DT_Chapter_04|Subs_C060|L_002": "SOD 비밀 시설 말입니까?",
 "DT_Chapter_04|Subs_C060|L_003": "적외선 영상을 보면 빌딩 아래에\n지하 시설이 있어.",
 "DT_Chapter_04|Subs_C060|L_004": "지하까지 한 방에 구멍을 뚫어 줄게.",
 "DT_Chapter_04|Subs_C060|L_005": "잠깐, 너무 가까워!",
 "DT_Chapter_04|Subs_C060|L_006": "엄폐해! 착탄까지 3초!",
 "DT_Chapter_04|Subs_C060|L_007": "젠장! 엎드려!",
 "DT_Chapter_04|Subs_C060|L_008": "나쁘지 않군.",
 "DT_Chapter_04|Subs_C062|L_001": "좋아, 한 명씩 내려가.",
 "DT_Chapter_04|Subs_C070|L_002": "뭐야, 이건…?",
 "DT_Chapter_04|Subs_C080|L_001": "둘로 나뉘자.",
 "DT_Chapter_04|Subs_C080|L_002": "우리는 서쪽을 확인한다.",
 "DT_Chapter_04|Subs_C080|L_003": "아이반, 넌 동쪽을 맡아.",
 "DT_Chapter_04|Subs_C080|L_004": "닉, 아이반과 가.",
 "DT_Chapter_04|Subs_C080|L_005": "알겠습니다!",
 "DT_Chapter_04|Subs_C090|L_001": "전기가 나갔군.",
 "DT_Chapter_04|Subs_C090|L_002": "비상 발전기가 있을 거다.",
 "DT_Chapter_04|Subs_C090|L_003": "명색이 병원이잖아.",
 "DT_Chapter_04|Subs_C100|L_002": "대체 이게 다 뭐야?",
 "DT_Chapter_04|Subs_C110|L_003": "닉! 젠장!",
 "DT_Chapter_04|Subs_C120|L_001": "닉의 생체 신호가 끊겼어.",
 "DT_Chapter_04|Subs_C120|L_002": "당했습니다…\n뭐가 죽였는지조차 모르겠습니다.",
 "DT_Chapter_04|Subs_C120|L_003": "스텔라, 이 시스템에 침입할 수 있어?",
 "DT_Chapter_04|Subs_C120|L_004": "\n해 볼게.\n대위, 엑소슈트 데이터 링크를 서버에 연결해.",
 "DT_Chapter_04|Subs_C120|L_005": "\n들어갔어!\n소련 정부가 바이오프레파라트에 보낸 보고서 같아…",
 "DT_Chapter_04|Subs_C120|L_006": "“유전자 변형 약”으로 검색해 줘.",
 "DT_Chapter_04|Subs_C120|L_007": "\n찾았어.\n“‘유전자 변형 약’ 투여 피험자의 줄기세포 암 형성…”\n아까 그것들은 여기 환자였나 봐.",
 "DT_Chapter_04|Subs_C120|L_008": "빅 마우스는 SOD의 생물 병기 전문가였어.\n러시아를 노린 새 무기를 만들면서\n파나마 때처럼 여기 주민들한테\n시험해 본 모양이군.",
 "DT_Chapter_04|Subs_C120|L_009": "\n거기서 멈춰.\n빅 마우스, 그룬들라 샤하.",
 "DT_Chapter_04|Subs_C120|L_010": "…C4까지?\n왜 피험자 목록에 있는 거지?",
 "DT_Chapter_04|Subs_C120|L_011": "아이반?",
 "DT_Chapter_04|Subs_C120|L_012": "소련 정부가 시작한 프로그램인데\n1990년에 포기했어. 하지만 SOD는 계속했지.\n소녀 C4는 생물 병기에 타고난 내성이 있었나 봐.\n하지만… 부작용이 있었어.\nSOD는 지금도 그 아이 피를 매개체로\n공작원용 유전자 변형 약을 만들고 있어.",
 "DT_Chapter_04|Subs_R010|L_001": "젠장, 파나마식 환영 인사군요.",
 "DT_Chapter_04|Subs_R010|L_002": "레이더가 먹통인 줄 알았는데\n어떻게 이렇게 빨리 들이닥친 거죠?",
 "DT_Chapter_04|Subs_R010|L_003": "아니, 요행이겠지.",
 "DT_Chapter_04|Subs_R010|L_004": "아무래도 이 파티,\n우릴 위해 연 건 아닌 모양이다.",
 "DT_Chapter_04|Subs_R010|L_005": "그럼 그 파티, 저희가 깽판 쳐 드리죠!",
 "DT_Chapter_04|Subs_R010|L_006": "파편 조심해!",
 "DT_Chapter_04|Subs_R010|L_007": "적 증원입니다!",
 "DT_Chapter_04|Subs_R010|L_008": "쏴, 쏴!",
 "DT_Chapter_04|Subs_R010|L_009": "엄폐해!",
 "DT_Chapter_04|Subs_R010|L_010": "앞에 다리다.\n숨을 데가 없어. 정신 바짝 차려.",
 "DT_Chapter_04|Subs_R010|L_011": "오른쪽에 쾌속정! 조심해!",
 "DT_Chapter_04|Subs_R020|L_001": "앞에 장갑차다! 엄폐해!",
 "DT_Chapter_04|Subs_R020|L_002": "이거 골치 아프겠는데.\n아이반, 무슨 수 없어?",
 "DT_Chapter_04|Subs_R020|L_003": "오, 먹혔군.",
 "DT_Chapter_04|Subs_R020|L_004": "뭘 하려는 거야? 도시를 쓸어버릴 셈인가?",
 "DT_Chapter_04|Subs_R020|L_005": "젠장! 엎드려!",
 "DT_Chapter_04|Subs_R030|L_001": "교회가 망가진 꼴은 보기 싫군.",
 "DT_Chapter_04|Subs_R030|L_002": "신이 있대도 여긴 없나 봐.",
 "DT_Chapter_04|Subs_R040|L_001": "끝이 없군.\n호텔 안으로 돌입한다!",
 "DT_Chapter_04|Subs_R040|L_002": "가, 아이반. 엄호한다.",
 "DT_Chapter_04|Subs_R040|L_003": "빨리 가!",
 "DT_Chapter_04|Subs_R050|L_001": "다들 괜찮나? 좋아, 가자.",
 "DT_Chapter_04|Subs_R050|L_002": "지대공 미사일이 아직 살아 있다.",
 "DT_Chapter_04|Subs_R050|L_003": "직격이다!",
 "DT_Chapter_04|Subs_R050|L_004": "이러다 건물째로 우릴 덮치겠어!",
 "DT_Chapter_04|Subs_R060|L_001": "어디 갔어?",
 "DT_Chapter_04|Subs_R060|L_002": "우릴 적으로 착각했나 봐.",
 "DT_Chapter_04|Subs_R060|L_003": "저 건물로 들어간 것 같습니다.",
 "DT_Chapter_04|Subs_R060|L_004": "좋아, 민간인을 확보해.",
 "DT_Chapter_04|Subs_R070|L_001": "차림새로 보면\n뭔가에 감염된 민간인이었던 것 같은데…",
 "DT_Chapter_04|Subs_R070|L_002": "팔이 떨어져 나갔는데 살아 있다고?\n뭔진 몰라도 사람은 아니야.",
 "DT_Chapter_04|Subs_R070|L_003": "소령님, 분석할 이미지를 보내겠습니다.",
 "DT_Chapter_04|Subs_R070|L_004": "알았어.\nSOD 공격이랑 관계있을지도 몰라.",
 "DT_Chapter_04|Subs_R080|L_002": "건너편 다리에 적!",
 "DT_Chapter_04|Subs_R080|L_003": "거기다 중전차까지!",
 "DT_Chapter_04|Subs_R080|L_004": "엎드려!",
 "DT_Chapter_04|Subs_R080|L_005": "양쪽에서 조여 오잖아!",
 "DT_Chapter_04|Subs_R080|L_006": "젠장, 우리 화력으론 전혀 상대가 안 돼.",
 "DT_Chapter_04|Subs_R080|L_007": "소령님! 항공 지원 없이는\n저 전차를 못 뚫습니다!",
 "DT_Chapter_04|Subs_R080|L_008": "알았어. 무인 공격기가 사정권 안에 있어.",
 "DT_Chapter_04|Subs_R080|L_009": "적이 더 옵니다!",
 "DT_Chapter_04|Subs_R080|L_010": "닉! 수를 줄여!",
 "DT_Chapter_04|Subs_R080|L_011": "하고 있습니다!",
 "DT_Chapter_04|Subs_R080|L_012": "상황이 급합니다. 항공 지원은 아직입니까!?",
 "DT_Chapter_04|Subs_R080|L_013": "무인 공격기가 그쪽으로 가는 중인데\n대공 사격 때문에 늦어지고 있어… 버텨, 델타!",
 "DT_Chapter_04|Subs_R090|L_002": "조심해.\n천장이 무너질 것 같다.",
 "DT_Chapter_04|Subs_R090|L_003": "웬 철창이야?",
 "DT_Chapter_04|Subs_R090|L_004": "동물 실험실… 실험인지 뭔지 하던 곳이군.",
 "DT_Chapter_04|Subs_R090|L_005": "델타, 더 깊이 들어가면 음성 통신이 끊길지도 몰라.\n하지만 위치는 추적할 수 있어.",
 "DT_Chapter_04|Subs_R090|L_006": "알겠습니다.",
 "DT_Chapter_04|Subs_R090|L_007": "잡담 그만.\n닉, 아이반과 정찰을 맡아.\n나머지는 여기서 대기.",
 "DT_Chapter_04|Subs_R100|L_001": "또 저것들이야!",
 "DT_Chapter_04|Subs_R100|L_002": "여기 둥지라도 튼 거야?",
 "DT_Chapter_04|Subs_R100|L_003": "이거 완전 엿 같네!",
 "DT_Chapter_04|Subs_R100|L_004": "뭐, 뭐야 이 녀석들은!?",
 "DT_Chapter_04|Subs_R100|L_005": "잔뜩 쏴 줬는데 끄떡도 안 해!",
 "DT_Chapter_04|Subs_R100|L_006": "칼을 써 봐. 그게 더 잘 먹힌다.",
 "DT_Chapter_04|Subs_R100|L_007": "SOD 부대다… 젠장, 이게 무슨 냄새야?!",
 "DT_Chapter_04|Subs_R100|L_008": "증거를 태워 없애는 거야.",
 "DT_Chapter_04|Subs_R110|L_001": "이런 건 계약에 없었다고!",
 "DT_Chapter_04|Subs_R110|L_002": "젠장,\n이 괴물들은 잠도 안 자냐?",
 "DT_Chapter_04|Subs_R120|L_001": "빌어먹을, 길이 끊겼어.",
 "DT_Chapter_04|Subs_R120|L_002": "그런 모양이군. 다시 올라가야겠다.",
 "DT_Chapter_04|Subs_R120|L_003": "일단 지상으로 돌아갈 수밖에 없겠군.",
 "DT_Chapter_04|Subs_R120|L_004": "지상에 병원으로 들어가는 입구가 있을 거다.",
 "DT_Chapter_04|Subs_R130|L_001": "밖으로 나왔습니다… 어떻게 할까요, 대위님?",
 "DT_Chapter_04|Subs_R130|L_002": "여긴…",
 "DT_Chapter_04|Subs_R130|L_003": "저기가 병원이다. 가자!",
 "DT_Chapter_04|Subs_R130|L_004": "조심해!",
 "DT_Chapter_04|Subs_R140|L_001": "이런 미친, 장난하냐!",
 "DT_Chapter_04|Subs_R140|L_002": "젠장, 여긴 괴물 천지잖아!",
 "DT_Chapter_04|Subs_R140|L_003": "여기서 SOD의 목표는\n망할 괴물 사냥이었던 모양이군.",
 "DT_Chapter_04|Subs_R140|L_004": "저게 마지막이야?",
 "DT_Chapter_04|Subs_R140|L_005": "아니, 글쎄다.\n병원 안으로 들어간다. 계속 경계 태세!",
 "DT_Chapter_04|Subs_R150|L_001": "아이반! 가자!",
 "DT_Chapter_04|Subs_R150|L_002": "병원은 질색이야.",
 "DT_Chapter_04|Subs_R150|L_003": "아직 누가 여기서\n일하는 것 같은데.",
 "DT_Chapter_04|Subs_R160|L_001": "어이, 문이 잠겼어.",
 "DT_Chapter_04|Subs_R160|L_002": "아이반! 괜찮아?!",
 "DT_Chapter_04|Subs_R160|L_003": "안 열려!",
 "DT_Chapter_04|Subs_R160|L_004": "젠장!",
 "DT_Chapter_04|Subs_R160|L_005": "대체 뭐였던 거야?",
 "DT_Chapter_04|Subs_R170|L_001": "됐다.",
 "DT_Chapter_04|Subs_R180|L_001": "괴물 소굴에 들어와 버렸다.\n그쪽 상황은?",
 "DT_Chapter_04|Subs_R180|L_002": "그건 나중에 보고하겠습니다.",
 "DT_Chapter_04|Subs_R190|L_001": "대위님! 이 아래에서 의료 시설을 발견했습니다.",
 "DT_Chapter_04|Subs_R190|L_002": "또 실험실이냐?",
 "DT_Chapter_04|Subs_R190|L_003": "아뇨, 그보다는… 변이 생물을\n배양하던 곳 같습니다. 아직 살아 있습니다!",
 "DT_Chapter_04|Subs_R190|L_004": "맙소사.\n수색 끝내고 당장 거기서 나와.",
 "DT_Chapter_04|Subs_R200|L_001": "어디까지 이어진 걸까?",
 "DT_Chapter_04|Subs_R200|L_002": "이쪽은 거의 제압했다.\n그쪽 위치는?",
 "DT_Chapter_04|Subs_R200|L_003": "아직 실험 시설 안입니다.\n꽤 깊이까지 이어져 있습니다.",
 "DT_Chapter_04|Subs_R200|L_004": "알았다. 조심해서 진행해.",
 "DT_Chapter_04|Subs_R200|L_005": "라저.",
 "DT_Chapter_04|Telops|Chapter4Time_a": "현지 시간 11월 8일 17:00",
 "DT_Chapter_04|Telops|Chapter4Place_a": "브라트 경제특구\n중앙로",
 "DT_Chapter_04_Mg1|Subs_Set01|L_001": "짐, 샘은 오른쪽. 닉은 나와 왼쪽.\n정신 바짝 차려, 적이 사방에 있다.",
 "DT_Chapter_04_Mg1|Subs_Set01|L_002": "멈추지 마!",
 "DT_Chapter_04_Mg1|Subs_Set01|L_003": "이 자식들, 떼로 몰려다니네.",
 "DT_Chapter_04_Mg1|Subs_Set01|L_004": "산 채로 태우고 있어.",
 "DT_Chapter_04_Mg1|Subs_Set02|L_001": "고맙다, 친구.",
 "DT_Chapter_04_Mg1|Subs_Set02|L_002": "잘했어!",
 "DT_Chapter_04_Mg1|Subs_Set02|L_003": "신세 졌다.",
 "DT_Chapter_04_Mg1|Subs_Set03|L_001": "젠장, 넌 누구 편이야?",
 "DT_Chapter_04_Mg1|Subs_Set03|L_002": "제대로 겨눠! 목표는 저쪽이다!",
 "DT_Chapter_04_Mg1|Subs_Set03|L_003": "한 번만 더 그러면 벌집으로 만들어 준다!",
 "DT_Chapter_04_Mg1|Subs_Set04|L_001": "무기 다뤄 본 적은 있어?\n엄호하라고, 젠장!",
 "DT_Chapter_04_Mg1|Subs_Set04|L_002": "아이반, 정신 차려!",
 "DT_Chapter_04_Mg1|Subs_Set05|L_001": "서둘러!\n다음 포격은 못 버틴다!",
 "DT_Chapter_04_Mg1|Subs_Set05|L_002": "꾸물대지 마!",
 "DT_Chapter_04_Mg1|Subs_Set05|L_003": "이러다 큰일 나! 당장 해치워!",
 "DT_Chapter_04_Mg2|Subs_Set01|L_001": "목표를 록온해!",
 "DT_Chapter_04_Mg2|Subs_Set01|L_002": "제대로 좀 겨눠, 젠장!",
 "DT_Chapter_04_Mg2|Subs_Set01|L_003": "그 선글라스 내놔! 내가 과녁을 찍어 주지!"
}