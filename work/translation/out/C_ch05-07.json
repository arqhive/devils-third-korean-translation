{
 "DT_Chapter_05|MissionObjectives|Title_A": "환락가를 조사하라",
 "DT_Chapter_05|MissionObjectives|M_00": "정문을 열어라",
 "DT_Chapter_05|MissionObjectives|M_01": "하수도로 우회하라",
 "DT_Chapter_05|MissionObjectives|Title_B": "적 집결지를 찾아라",
 "DT_Chapter_05|MissionObjectives|M_03": "광장의 적을 소탕하라",
 "DT_Chapter_05|MissionObjectives|M_04": "다른 루트를 찾아라",
 "DT_Chapter_05|MissionObjectives|M_05": "우회해서 적 진지로 침투하라",
 "DT_Chapter_05|MissionObjectives|M_06": "델타 분대를 엄호 사격하라",
 "DT_Chapter_05|MissionObjectives|M_07": "적 집결지로 접근하라",
 "DT_Chapter_05|MissionObjectives|M_08": "적 헬기를 격추하라",
 "DT_Chapter_05|MissionObjectives|Title_C": "적 기지로 가라",
 "DT_Chapter_05|MissionObjectives|M_10": "적 지휘관을 무력화하라",
 "DT_Chapter_05|MissionObjectives|Title": "환락가를 조사하라",
 "DT_Chapter_05|Settings|Title": "홍등가",
 "DT_Chapter_05|Subs_C010|L_001": "이 앞 산 중턱에 밝은 곳이 있을 거야.",
 "DT_Chapter_05|Subs_C010|L_002": "전 세계가 정전된 걸 생각하면\n그 불빛은 적이 있다는 유력한 단서야.\n최대한 빨리 그 구역으로 가.",
 "DT_Chapter_05|Subs_C030|L_002": "문이 꽉 잠겼어.\n뚫고 들어가야겠어.",
 "DT_Chapter_05|Subs_C030|L_003": "물러나!\n샘, 폭약 설치해!",
 "DT_Chapter_05|Subs_C030|L_004": "적이 쏜다!",
 "DT_Chapter_05|Subs_C030|L_005": "6시 방향!",
 "DT_Chapter_05|Subs_C032|L_001": "준비 완료!",
 "DT_Chapter_05|Subs_C032|L_002": "엄폐해!",
 "DT_Chapter_05|Subs_C032|L_003": "폭파!",
 "DT_Chapter_05|Subs_C032|L_004": "와! 흠집 하나 없네.",
 "DT_Chapter_05|Subs_C032|L_005": "대체 뭘로 만든 거야, 저건?",
 "DT_Chapter_05|Subs_C032|L_006": "대위님! 틈을 찾았어요.\n여기로 들어갈 수 있어요!",
 "DT_Chapter_05|Subs_C032|L_007": "가자!",
 "DT_Chapter_05|Subs_C035|L_001": "방금 고양이였나?",
 "DT_Chapter_05|Subs_C035|L_002": "아니, 고양이는 아냐.",
 "DT_Chapter_05|Subs_C040|L_001": "저 빌어먹을 머신건부터 없애야 해!",
 "DT_Chapter_05|Subs_C040|L_002": "아이반! 뒷길로 돌아가!",
 "DT_Chapter_05|Subs_C040|L_003": "우리가 끌어 두겠다! 측면을 쳐!",
 "DT_Chapter_05|Subs_C040|L_004": "가!",
 "DT_Chapter_05|Subs_C060|L_001": "덕분에 살았다…",
 "DT_Chapter_05|Subs_C060|L_002": "…하지만 다음엔 좀 더 빨리 해 줄래?",
 "DT_Chapter_05|Subs_C070|L_001": "저 도색은 또 뭐야?",
 "DT_Chapter_05|Subs_C070|L_002": "앨범 커버 같군.",
 "DT_Chapter_05|Subs_C070|L_003": "나이 티 난다고, 대위.",
 "DT_Chapter_05|Subs_C070|L_004": "한 방 맡아 주겠어?",
 "DT_Chapter_05|Subs_C070|L_005": "들키기 전에 해치우자.",
 "DT_Chapter_05|Subs_C090|L_001": "제인.",
 "DT_Chapter_05|Subs_C090|L_002": "어머, 아이반.\n네가 먼저 내 침실에 찾아온 게 몇 년 만이야?",
 "DT_Chapter_05|Subs_C090|L_003": "빅 마우스 얘기 들었어.\n이제 난 미망인이네.",
 "DT_Chapter_05|Subs_C090|L_004": "살다 보면 별일이 다 있다니까.",
 "DT_Chapter_05|Subs_C090|L_005": "넌 불 켜 놓는 걸 좋아하지…",
 "DT_Chapter_05|Subs_C090|L_006": "…하지만 난 어둠 속에서 훨씬 잘 움직여.",
 "DT_Chapter_05|Subs_C100|L_002": "내 눈 마음에 들어?\n소련이 준 선물이야.",
 "DT_Chapter_05|Subs_C100|L_003": "우린 유전자 변형 약을 시험하라는 명령을 받았어.\n빅 마우스, 샤하, 네 귀여운 C4…",
 "DT_Chapter_05|Subs_C100|L_004": "다들 괴로워했어.\n우린 이제 인간도 아니야.\n괴물이야!",
 "DT_Chapter_05|Subs_C110|L_002": "제인.",
 "DT_Chapter_05|Subs_C110|L_003": "SOD 기지는 어디 있지?",
 "DT_Chapter_05|Subs_C110|L_005": "더 알고 싶으면\n레늄 플랜트에 있는 포로한테 물어봐.\n그 남자가 말해 줄 거야.",
 "DT_Chapter_05|Subs_C110|L_006": "C4는 변해 버린 몸을 너한테 숨겼어.\n그런 자기 모습이 부끄러웠던 거야.",
 "DT_Chapter_05|Subs_C110|L_007": "그 애는 널 숭배했어, 아이반.",
 "DT_Chapter_05|Subs_C110|L_008": "내 눈은 모든 걸 볼 수 있어.\n하지만 아무것도 바꿀 순 없지.",
 "DT_Chapter_05|Subs_C110|L_009": "죽이고 싶으면 죽여.\n삶이든 죽음이든… 다 똑같아.",
 "DT_Chapter_05|Subs_C110|L_011": "어둠을 마주해라.\n진정한 빛은 거기서 찾게 될 거다.",
 "DT_Chapter_05|Subs_R010|L_001": "누가 저 건물을\n엉뚱한 데 떨궈 놨네.",
 "DT_Chapter_05|Subs_R010|L_002": "사실 거긴 관광객과 서구 고관들이\n“오락 목적”으로 쓰라고 만든 곳이야.",
 "DT_Chapter_05|Subs_R010|L_003": "나야 좋지.",
 "DT_Chapter_05|Subs_R020|L_001": "문으로 가.",
 "DT_Chapter_05|Subs_R020|L_002": "와, 끝내주네.",
 "DT_Chapter_05|Subs_R020|L_003": "불이 전부 켜져 있어…",
 "DT_Chapter_05|Subs_R020|L_004": "누군가 있는 게 분명해.",
 "DT_Chapter_05|Subs_R020|L_005": "잡담 그만!\n진입 지점을 확인해.",
 "DT_Chapter_05|Subs_R030|L_001": "젠장! 이 녀석들 어디서 나온 거야?",
 "DT_Chapter_05|Subs_R030|L_002": "우릴 따라 들어왔어!",
 "DT_Chapter_05|Subs_R030|L_003": "다리가 너무 좁아.\n정면 돌파는 힘들겠어.",
 "DT_Chapter_05|Subs_R040|L_001": "먼저 가.",
 "DT_Chapter_05|Subs_R040|L_002": "왜 그래? 움직여!",
 "DT_Chapter_05|Subs_R050|L_001": "이쪽이다.",
 "DT_Chapter_05|Subs_R050|L_003": "대위, 이 구역 중앙 근처에\n열원이 모여드는 게 잡혀. 정찰 부탁해.",
 "DT_Chapter_05|Subs_R050|L_004": "함정 냄새가 나는데요.",
 "DT_Chapter_05|Subs_R050|L_005": "그럴지도.\n하지만 지금 잡히는 건 이것뿐이야.\n신호는 중앙 거리 앞쪽에서 나와.\n지금 표시할게.",
 "DT_Chapter_05|Subs_R050|L_006": "알겠습니다!",
 "DT_Chapter_05|Subs_R050|L_007": "여기서 거리로 올라갈 수 있겠어.",
 "DT_Chapter_05|Subs_R050|L_008": "위로 가는 사다리가 있어.\n발 조심해.",
 "DT_Chapter_05|Subs_R060|L_001": "또 왔군.",
 "DT_Chapter_05|Subs_R060|L_002": "적 발견!",
 "DT_Chapter_05|Subs_R060|L_003": "모래주머니. 우릴 기다리고 있었던 건가?",
 "DT_Chapter_05|Subs_R060|L_004": "클리어!",
 "DT_Chapter_05|Subs_R060|L_005": "준비됐나? 출발!",
 "DT_Chapter_05|Subs_R070|L_001": "12시 방향, 2층 창문에 스나이퍼!",
 "DT_Chapter_05|Subs_R070|L_002": "젠장, 여기 문도 잠겼습니다!",
 "DT_Chapter_05|Subs_R070|L_003": "돌아가야겠다!",
 "DT_Chapter_05|Subs_R070|L_004": "이 동상은 누구야?\n꽤 거물인가 본데.",
 "DT_Chapter_05|Subs_R080|L_001": "잠겼군.\n아이반, 저 가게로 지나갈 수 있는지 봐.\n짐, 같이 가.",
 "DT_Chapter_05|Subs_R080|L_002": "알겠습니다!",
 "DT_Chapter_05|Subs_R080|L_003": "아이반, 이쪽이다!\n따라와.",
 "DT_Chapter_05|Subs_R090|L_001": "적이냐?",
 "DT_Chapter_05|Subs_R090|L_002": "아닙니다.\n그냥, 뭔가 느껴져서요.",
 "DT_Chapter_05|Subs_R090|L_003": "그 망할 문이나 열어.",
 "DT_Chapter_05|Subs_R090|L_005": "왜 그래?",
 "DT_Chapter_05|Subs_R090|L_006": "적의 습격입니다!",
 "DT_Chapter_05|Subs_R090|L_007": "제인 부대겠군.",
 "DT_Chapter_05|Subs_R090|L_008": "빨리 해!",
 "DT_Chapter_05|Subs_R090|L_009": "서둘러!",
 "DT_Chapter_05|Subs_R090|L_010": "버텨! 거의 다 됐다.",
 "DT_Chapter_05|Subs_R090|L_011": "뚫었습니다!",
 "DT_Chapter_05|Subs_R090|L_012": "엄호한다!",
 "DT_Chapter_05|Subs_R100|L_001": "저 녀석들, 움직임이 장난 아니군!",
 "DT_Chapter_05|Subs_R100|L_002": "무슨 닌자도 아니고!\n",
 "DT_Chapter_05|Subs_R100|L_003": "클리어!",
 "DT_Chapter_05|Subs_R100|L_004": "조준이 안 돼!",
 "DT_Chapter_05|Subs_R100|L_005": "우리 엑소슈트보다 빨라!\n대체 정체가 뭐야?",
 "DT_Chapter_05|Subs_R100|L_006": "모르겠어…\n하지만 우리가 올 걸 알고 있었던 것 같아.",
 "DT_Chapter_05|Subs_R100|L_007": "방심하지 마.",
 "DT_Chapter_05|Subs_R100|L_008": "위다!",
 "DT_Chapter_05|Subs_R100|L_009": "다 똑같아 보이잖아.\n여기가 대체 어디야?",
 "DT_Chapter_05|Subs_R110|L_001": "건물 모양이 바뀌었군.",
 "DT_Chapter_05|Subs_R110|L_002": "매복이다!",
 "DT_Chapter_05|Subs_R110|L_003": "엄폐해!",
 "DT_Chapter_05|Subs_R110|L_004": "저 서치라이트 때문에 하나도 안 보여!",
 "DT_Chapter_05|Subs_R120|L_001": "어서, 움직여!",
 "DT_Chapter_05|Subs_R130|L_001": "젠장! 제대로 걸려들었어!",
 "DT_Chapter_05|Subs_R130|L_002": "정신 차려! 화력이 엄청나.\n창문에 기관총 2대, 지상에 1대.",
 "DT_Chapter_05|Subs_R130|L_003": "꼼짝 못 하겠어!",
 "DT_Chapter_05|Subs_R130|L_004": "엄폐물에서 나가지 마!\n아이반, 측면을 쳐 봐!",
 "DT_Chapter_05|Subs_R130|L_005": "방어가 엄청 단단하잖아. 대체 뭘 지키는 거야?",
 "DT_Chapter_05|Subs_R130|L_006": "위치 사수! 버텨!",
 "DT_Chapter_05|Subs_R130|L_007": "아이반, 저 총좌를 없애!",
 "DT_Chapter_05|Subs_R130|L_008": "여기 완전히 두들겨 맞고 있다!\n총좌를 박살 내!",
 "DT_Chapter_05|Subs_R140|L_001": "잘했다!\n이제 나머지 하나도 없애!",
 "DT_Chapter_05|Subs_R140|L_002": "야호! 아이반 더 테러블이다, 하하!",
 "DT_Chapter_05|Subs_R140|L_003": "대위, 괜찮아?",
 "DT_Chapter_05|Subs_R140|L_004": "네, 아직 멀쩡합니다.",
 "DT_Chapter_05|Subs_R150|L_001": "총좌가 또 있어!",
 "DT_Chapter_05|Subs_R150|L_002": "이번엔 하나다. 아이반?",
 "DT_Chapter_05|Subs_R150|L_003": "아이반, 녀석들 측면을 쳐!",
 "DT_Chapter_05|Subs_R150|L_004": "6시 방향에 적!",
 "DT_Chapter_05|Subs_R150|L_005": "거기 총좌를 써!",
 "DT_Chapter_05|Subs_R150|L_006": "적이 쫓아온다…\n높은 곳으로 올라가서 엄폐해!",
 "DT_Chapter_05|Subs_R150|L_007": "이게 마지막인 것 같군.\n가자.",
 "DT_Chapter_05|Subs_R150|L_008": "막혔네. 젠장, 더 구경하고 싶었는데.",
 "DT_Chapter_05|Subs_R150|L_009": "그럼 휴가 때 여기 예약하든가.\n소령 말로는 적 집결 지점이\n이 거리 끝이다.\n호텔 옆 앞쪽 골목으로 간다.",
 "DT_Chapter_05|Subs_R160|L_001": "여길 지나가는 거야?",
 "DT_Chapter_05|Subs_R160|L_002": "아래쪽에 적! 전원 내려가.",
 "DT_Chapter_05|Subs_R160|L_003": "앞에도 적이 더 있어.",
 "DT_Chapter_05|Subs_R160|L_004": "여긴 유난히 적이 많군. 뭘 지키는 건가?",
 "DT_Chapter_05|Subs_R160|L_005": "근처에 옥상으로 가는 엘리베이터가 있어.",
 "DT_Chapter_05|Subs_R160|L_006": "열원에 움직임은 있습니까?",
 "DT_Chapter_05|Subs_R160|L_007": "아니…\n열원은 그대로야.",
 "DT_Chapter_05|Subs_R160|L_008": "이거군.",
 "DT_Chapter_05|Subs_R160|L_009": "좋아, 가자.",
 "DT_Chapter_05|Subs_R170|L_002": "타고 있던 건 네……",
 "DT_Chapter_05|Subs_R170|L_003": "아이반, 무슨 일 있어?",
 "DT_Chapter_05|Subs_R170|L_004": "쓸 만한 정보는 다 모아라.",
 "DT_Chapter_05|Subs_R170|L_005": "난 먼저 가겠다, 대위.\n누가 날 기다리는 것 같아서.",
 "DT_Chapter_05|Subs_R170|L_006": "개자식들, 이 도시를\n집결지로 만들어 놨어.",
 "DT_Chapter_05|Subs_R170|L_007": "아이반은 왜 저래?",
 "DT_Chapter_05|Subs_R170|L_008": "몰라, 근데 꽤 열받은 것 같던데.",
 "DT_Chapter_05|Subs_R170|L_009": "덤불 뒤에 적! 측면을 조심해!",
 "DT_Chapter_05|Subs_R180|L_001": "제인.\n날 부르는 건가?",
 "DT_Chapter_05|Telops|Chapter5Time_a": "현지 시간 11월 10일 19:30",
 "DT_Chapter_05|Telops|Chapter5Place_a": "브라트 후지 중턱\n브라트 요시와라",
 "DT_Chapter_05_Mg1|Subs_Set01|L_001": "한 번 더 쏴!",
 "DT_Chapter_05_Mg1|Subs_Set01|L_002": "제대로 맞혀! 안 그러면 끝장이야!",
 "DT_Chapter_05_Mg1|Subs_Set01|L_003": "명중!",
 "DT_Chapter_05_Mg1|Subs_Set01|L_004": "끝장내!",
 "DT_Chapter_06|MissionObjectives|Title": "사로잡힌 과학자를 구출하라",
 "DT_Chapter_06|MissionObjectives|M_00": "적을 쓰러뜨리고 공장 안으로 나아가라",
 "DT_Chapter_06|MissionObjectives|M_01": "우회로로 앞서 정찰하라",
 "DT_Chapter_06|MissionObjectives|M_02": "용광로 출구로 가라",
 "DT_Chapter_06|MissionObjectives|M_03": "건너편 절벽의 적과 교전하라",
 "DT_Chapter_06|MissionObjectives|M_04": "적 헬기를 파괴하라",
 "DT_Chapter_06|MissionObjectives|M_05": "사로잡힌 과학자에게 서둘러 가라",
 "DT_Chapter_06|MissionObjectives|M_06": "적 파워 슈트를 파괴하라",
 "DT_Chapter_06|MissionObjectives|M_07": "냉각탑 안으로 계속 나아가라",
 "DT_Chapter_06|MissionObjectives|M_08": "앞쪽 건물로 침투하라",
 "DT_Chapter_06|MissionObjectives|M_09": "적을 쓰러뜨리며 공장 안을 나아가라",
 "DT_Chapter_06|Settings|Title": "헤비메탈",
 "DT_Chapter_06|Subs_C010|L_001": "제인은 레늄 플랜트에 있다는\n포로 얘기를 했어.",
 "DT_Chapter_06|Subs_C010|L_002": "미국 정보통에 따르면 이 연구 시설은\n자연과학자 마에다 교수를 위해 지은 거야.\n초장갑 레늄 합금 개발로 알려진 사람이지.\n자료를 보내 둘게.",
 "DT_Chapter_06|Subs_C010|L_003": "초장갑 레늄 합금: 2012년 츠쿠바 공대의 마에다 교수는\n나노 결정 텅스텐·레늄을 발명.",
 "DT_Chapter_06|Subs_C010|L_004": "이 레늄 X의 경도와 강도는\n군사·항공 우주 산업을 혁신했고 레늄 가격은 급등.",
 "DT_Chapter_06|Subs_C010|L_005": "전차랑 전투기 장갑도 점점 레늄으로 바뀌는 중이다.",
 "DT_Chapter_06|Subs_C010|L_006": "아마 제인이 말한 포로는\n이 마에다 교수일 거야.",
 "DT_Chapter_06|Subs_C020|L_001": "더 알고 싶으면\n레늄 플랜트에 있는 포로한테 물어봐.\n그 남자가 말해 줄 거야.",
 "DT_Chapter_06|Subs_C030|L_001": "뒤를 조심해!",
 "DT_Chapter_06|Subs_C030|L_002": "먼저 가서 마에다 교수를 확보해!\nSOD가 섬 밖으로 빼돌리기 전에!",
 "DT_Chapter_06|Subs_C030|L_003": "가! 여긴 내가 맡는다.",
 "DT_Chapter_06|Subs_C050|L_001": "젠장!",
 "DT_Chapter_06|Subs_C050|L_002": "기다려, 아이반. 델타가 오고 있어!",
 "DT_Chapter_06|Subs_C050|L_003": "아이반!",
 "DT_Chapter_06|Subs_C050|L_004": "해치우자!",
 "DT_Chapter_06|Subs_C060|L_001": "여긴 도저히 못 뚫겠다.",
 "DT_Chapter_06|Subs_C060|L_002": "델타는 위치를 사수해!\n아이반과 난 위에서 친다!",
 "DT_Chapter_06|Subs_C070|L_001": "미국인인가?",
 "DT_Chapter_06|Subs_C070|L_002": "전부는 아니야.",
 "DT_Chapter_06|Subs_C070|L_003": "상관없지.\n이제 날 쏠 텐가?",
 "DT_Chapter_06|Subs_C070|L_004": "아니… 아직은.\n원하는 답을 주면 이 섬에서 꺼내 주지.",
 "DT_Chapter_06|Subs_C070|L_005": "그럼 축하할 일이구먼!",
 "DT_Chapter_06|Subs_C070|L_006": "같이 한잔하겠나?",
 "DT_Chapter_06|Subs_C070|L_007": "좋을 대로 하게.",
 "DT_Chapter_06|Subs_C070|L_008": "여기서 대체 무슨 일이 있었던 거지?",
 "DT_Chapter_06|Subs_C070|L_009": "이 섬에서 레늄이 발견된 게 시작이었지.\n지구에서 가장 단단한 금속이고 열에도 아주 강해…\n게다가 값도 아주 비싸지.",
 "DT_Chapter_06|Subs_C070|L_010": "그래서 내가 그걸 더 귀한 걸로 만들어 줬지.\n내 합금 “레늄 X”는 이제 모든 군사 용도에 필수가 됐어.\n그랬더니 미국, 러시아, 일본이 갑자기 사이좋게 굴더니\n이른바 “경제특구”라는 걸 만들었지.",
 "DT_Chapter_06|Subs_C070|L_011": "SOD는 이거랑 무슨 상관이지?",
 "DT_Chapter_06|Subs_C070|L_012": "그 테러리스트 녀석들은 소련을 붕괴시킨\n현 러시아 정부와 미국을 뼛속까지 원망하고 있어!\n그래서 앙심 품은 녀석들이 광산을 차지한 게야.\n원수들 손에 레늄이 안 들어가게 하려고.",
 "DT_Chapter_06|Subs_C070|L_013": "녀석들은 어떻게 브라트에 발판을 마련했지?",
 "DT_Chapter_06|Subs_C070|L_014": "녀석들은 ‘제니트’라는 민간 경비 회사라면서\n항구로 들어왔지.\n소련 시절 연줄이라도 썼겠지. 섬 반대편의\n버려진 소련 기지를 차지했으니.",
 "DT_Chapter_06|Subs_C070|L_015": "아는 건 그게 다인가?",
 "DT_Chapter_06|Subs_C070|L_016": "여기 단말기는 네트워크에 연결돼 있구먼.\n아마 뭔가 찾을 수 있을 게야.",
 "DT_Chapter_06|Subs_C070|L_017": "전원은 어쩌지?",
 "DT_Chapter_06|Subs_C070|L_018": "그건 내가 도와주지.",
 "DT_Chapter_06|Subs_C070|L_019": "얘기는 그만!",
 "DT_Chapter_06|Subs_C070|L_021": "고맙구먼.",
 "DT_Chapter_06|Subs_C070|L_023": "부드럽구먼!",
 "DT_Chapter_06|Subs_C080|L_001": "아이반, 들려?",
 "DT_Chapter_06|Subs_C080|L_002": "듣고 있다.",
 "DT_Chapter_06|Subs_C080|L_003": "전원이 복구돼서 공장 중계 안테나로\n본부와 연락했어.\n무인 공격기 범위도 넓혔어.",
 "DT_Chapter_06|Subs_R010|L_001": "이 앞의 레늄 플랜트는\n이 섬에서 가장 중요한 곳 중 하나다.\n경계를 늦추지 마.",
 "DT_Chapter_06|Subs_R010|L_002": "클리어!",
 "DT_Chapter_06|Subs_R010|L_003": "적은 없는 것 같습니다.",
 "DT_Chapter_06|Subs_R020|L_001": "적이다!",
 "DT_Chapter_06|Subs_R020|L_002": "총이 안 먹혀!",
 "DT_Chapter_06|Subs_R020|L_003": "이 녀석들, 방탄 방패를 들고 있어! 성가시게!",
 "DT_Chapter_06|Subs_R020|L_004": "이놈들은 내가 처리한다!",
 "DT_Chapter_06|Subs_R020|L_005": "저런 방패는 처음 봐.\n레늄이 틀림없어!",
 "DT_Chapter_06|Subs_R020|L_006": "공격할 땐 방패를 내릴 거다.\n그때를 노려!",
 "DT_Chapter_06|Subs_R020|L_007": "빌어먹을 방패!",
 "DT_Chapter_06|Subs_R020|L_008": "잘 쐈어!",
 "DT_Chapter_06|Subs_R020|L_009": "잘 잡았어!",
 "DT_Chapter_06|Subs_R020|L_010": "위에도 적이다!",
 "DT_Chapter_06|Subs_R020|L_011": "엄폐해!",
 "DT_Chapter_06|Subs_R020|L_012": "우리가 붙잡아 두겠다!\n아이반, 돌아가서 뒤를 쳐!",
 "DT_Chapter_06|Subs_R020|L_013": "아이반을 엄호해!",
 "DT_Chapter_06|Subs_R020|L_014": "아이반, 너무 앞서 나가지 마!",
 "DT_Chapter_06|Subs_R030|L_001": "클리어!",
 "DT_Chapter_06|Subs_R030|L_002": "좋아, 간다.",
 "DT_Chapter_06|Subs_R030|L_003": "배관을 따라 난 통로로 간다.",
 "DT_Chapter_06|Subs_R030|L_004": "아이반, 위쪽 루트로 가. 우린 아래로 간다.\n들어갈 길이 있는지 찾아봐.",
 "DT_Chapter_06|Subs_R040|L_001": "으아, 뜨겁네.",
 "DT_Chapter_06|Subs_R040|L_002": "레늄 용광로다.",
 "DT_Chapter_06|Subs_R040|L_003": "펄펄 끓는 온천이 따로 없네.",
 "DT_Chapter_06|Subs_R040|L_004": "이만큼 있으면 우리 전부한테\n끝내주는 갑옷을 만들어 주겠네.",
 "DT_Chapter_06|Subs_R040|L_005": "난 이걸로 아이반 거 같은 칼을 갖고 싶어.",
 "DT_Chapter_06|Subs_R040|L_006": "지옥보다 뜨겁네. 빨리 빠져나가자.",
 "DT_Chapter_06|Subs_R040|L_007": "누가 먼저 녹을까? 우리야, 적이야?",
 "DT_Chapter_06|Subs_R040|L_008": "젠장! 또 용광로야.",
 "DT_Chapter_06|Subs_R040|L_009": "후, 육포 되는 줄 알았네.",
 "DT_Chapter_06|Subs_R050|L_001": "저게 브라트 후지구나… 끝내주네.",
 "DT_Chapter_06|Subs_R060|L_001": "저 다리를 건너야 하나?",
 "DT_Chapter_06|Subs_R060|L_002": "돌아갈 길은 없어.",
 "DT_Chapter_06|Subs_R060|L_003": "진짜냐? 다른 길은 없어?",
 "DT_Chapter_06|Subs_R060|L_004": "엄폐할 곳을 찾아!",
 "DT_Chapter_06|Subs_R070|L_001": "엄폐물이 부서졌다! 이동해!",
 "DT_Chapter_06|Subs_R070|L_002": "엄폐하면서 싸워!",
 "DT_Chapter_06|Subs_R070|L_003": "계속 움직여!",
 "DT_Chapter_06|Subs_R070|L_004": "지붕에 스나이퍼!",
 "DT_Chapter_06|Subs_R070|L_005": "계속 몰려온다!",
 "DT_Chapter_06|Subs_R070|L_006": "적 증원이다!",
 "DT_Chapter_06|Subs_R070|L_007": "이 새끼들, 대체 몇이나 있는 거야?!",
 "DT_Chapter_06|Subs_R070|L_008": "스나이퍼 조심해!",
 "DT_Chapter_06|Subs_R080|L_001": "젠장, 지독하게 끈질기네!",
 "DT_Chapter_06|Subs_R080|L_002": "좋았어!",
 "DT_Chapter_06|Subs_R090|L_001": "대위! 아이반이 꼼짝 못 하고 있어!\n지원 가능해?",
 "DT_Chapter_06|Subs_R090|L_002": "이쪽도 발이 묶였습니다.",
 "DT_Chapter_06|Subs_R090|L_003": "냉각탑을 올라가.\n통로를 따라가면 발전소야.",
 "DT_Chapter_06|Subs_R100|L_001": "정문은 글렀군.\n다른 길을 찾자.",
 "DT_Chapter_06|Subs_R100|L_002": "좋았어!",
 "DT_Chapter_06|Subs_R100|L_003": "조심해!\n뒤에!",
 "DT_Chapter_06|Subs_R100|L_004": "클리어!",
 "DT_Chapter_06|Subs_R100|L_005": "좋아, 이제 들어간다.",
 "DT_Chapter_06|Subs_R100|L_006": "마에다는 꼭대기 층 방에 있다.",
 "DT_Chapter_06|Subs_R110|L_001": "뭐, 해냈군.",
 "DT_Chapter_06|Subs_R110|L_002": "젠장! 저 친구, 방 청소 하나는 끝내주는군.",
 "DT_Chapter_06|Telops|Chapter6Time_a": "현지 시간 11월 10일 21:10",
 "DT_Chapter_06|Telops|Chapter6Place_a": "스타리 브라트섬\n브라트 후지 1합목",
 "DT_Chapter_06|Telops|Chapter6Time_b": "현지 시간 11월 10일 21:30",
 "DT_Chapter_06|Telops|Chapter6Place_b": "스타리 브라트섬\n공업 지대",
 "DT_Chapter_07|MissionObjectives|Title_A": "적 전선 기지에 침투하라",
 "DT_Chapter_07|MissionObjectives|M_00": "앞을 막는 적을 쓰러뜨려라",
 "DT_Chapter_07|MissionObjectives|M_01": "속도를 올려 틈을 뛰어넘어라",
 "DT_Chapter_07|MissionObjectives|M_02": "적 전선 기지에 침투하라",
 "DT_Chapter_07|MissionObjectives|M_03": "건물을 지키며 시간을 벌어라",
 "DT_Chapter_07|MissionObjectives|Title_B": "최대한 빨리 합류 지점으로 가라",
 "DT_Chapter_07|MissionObjectives|M_05": "폭약을 설치하라",
 "DT_Chapter_07|MissionObjectives|M_06": "해안의 적을 섬멸하라",
 "DT_Chapter_07|MissionObjectives|M_07": "게이트 잠금장치를 폭파하라",
 "DT_Chapter_07|MissionObjectives|M_08": "적을 쓸어버리며 계속 전진하라",
 "DT_Chapter_07|MissionObjectives|M_09": "배수관으로 탈출하라",
 "DT_Chapter_07|MissionObjectives|M_10": "숨은 적을 쓰러뜨려라",
 "DT_Chapter_07|MissionObjectives|M_11": "부두의 적을 소탕하라",
 "DT_Chapter_07|MissionObjectives|M_12": "폭약을 설치하라",
 "DT_Chapter_07|MissionObjectives|M_13": "잠수함 독의 적을 섬멸하라",
 "DT_Chapter_07|MissionObjectives|M_14": "합류 지점으로 향하라",
 "DT_Chapter_07|MissionObjectives|M_15": "헬기를 격추하라",
 "DT_Chapter_07|Settings|Title": "피스메이커",
 "DT_Chapter_07|Subs_C010|L_001": "아이반, 마에다 교수가 말한\n제니트 경비의 본거지가 여기다.\n알고 보니 SOD가 내세운 간판이더군.\n기지를 치는 건 쉽지 않을 거다.\n제니트 녀석들은 전부 소련 특수부대 출신이거든.",
 "DT_Chapter_07|Subs_C010|L_002": "실례합니다, 각하! 손님이 찾아왔습니다!",
 "DT_Chapter_07|Subs_C010|L_003": "이런, 기습이라니 어쩔 수 없군.\n행운을 빈다.\n이상이다.",
 "DT_Chapter_07|Subs_C025|L_001": "브라보와 찰리도 무사히 빠져나온 모양이다.",
 "DT_Chapter_07|Subs_C030|L_002": "혼자 걸을 수 있겠나?",
 "DT_Chapter_07|Subs_C030|L_003": "그래.\n이 정도는 괜찮다.",
 "DT_Chapter_07|Subs_C040|L_002": "어서, 빨리 끝내.",
 "DT_Chapter_07|Subs_C040|L_003": "이게 우리가 찾던 거다.",
 "DT_Chapter_07|Subs_C040|L_004": "문을 날려 버려.",
 "DT_Chapter_07|Subs_C040|L_005": "기다려. 안의 전자 기기까지 망가질지도 몰라.",
 "DT_Chapter_07|Subs_C040|L_006": "자물쇠를 잘라 내자.",
 "DT_Chapter_07|Subs_C040|L_007": "저 냉동고를 뚫는 데 시간이 걸릴 거다.\n다들, 적을 막아 둬.",
 "DT_Chapter_07|Subs_C040|L_008": "응사해!",
 "DT_Chapter_07|Subs_C050|L_001": "저건 대체 뭐야?",
 "DT_Chapter_07|Subs_C050|L_002": "옆 섬에 있는 우주 기지다.",
 "DT_Chapter_07|Subs_C050|L_003": "“우주 기지”는 무슨.\n소련식으로 하면 “ICBM 발사 기지”지.",
 "DT_Chapter_07|Subs_C050|L_004": "소령님, 믈라드시 브라트로 갈\n수송 수단이 당장 필요합니다!",
 "DT_Chapter_07|Subs_C050|L_005": "알았어, 바로 할게.",
 "DT_Chapter_07|Subs_C050|L_006": "냉전 시대 설계 같은데…\n저런 건 처음 봐.",
 "DT_Chapter_07|Subs_C050|L_007": "애초에 보라고 만든 게 아니지.",
 "DT_Chapter_07|Subs_C050|L_008": "공항에서 헬기를 찾았어.\n믈라드시 브라트까지 다 태울 수 있는 크기야.\n5분 안에 띄울게.\n착륙 지점으로 가. 지금 좌표 보낼게.",
 "DT_Chapter_07|Subs_C050|L_009": "바로 간다.\n그동안 캐러웨이한테 “차르 벨”이라는\n소련 위성 정보가 있는지 알아봐 줘.\n옛 소련군 장군 아이작 쿠마노와도 대조해 보고.",
 "DT_Chapter_07|Subs_C050|L_010": "알았어.\n일단 합류 지점으로 와!",
 "DT_Chapter_07|Subs_C050|L_011": "아이작… 누구?",
 "DT_Chapter_07|Subs_C070|L_001": "이런 씨발.",
 "DT_Chapter_07|Subs_C070|L_002": "토폴-M.\n소련의 이동식 ICBM 발사대다.\n나쁘지 않군.",
 "DT_Chapter_07|Subs_C070|L_003": "이대로 둘 순 없지.",
 "DT_Chapter_07|Subs_C070|L_004": "폭약을 설치하자.",
 "DT_Chapter_07|Subs_C076|L_001": "어디 있는 거야?!",
 "DT_Chapter_07|Subs_C076|L_002": "엄폐해!",
 "DT_Chapter_07|Subs_C076|L_003": "적이 안 보인다!",
 "DT_Chapter_07|Subs_C076|L_004": "안 보입니다!",
 "DT_Chapter_07|Subs_C076|L_005": "완전히 박살 나고 있다!",
 "DT_Chapter_07|Subs_C076|L_006": "저건…",
 "DT_Chapter_07|Subs_C076|L_007": "광학 위장?!",
 "DT_Chapter_07|Subs_C080|L_002": "전부 날려 버려!",
 "DT_Chapter_07|Subs_C080|L_003": "여기에도 폭약을 놔!",
 "DT_Chapter_07|Subs_C085|L_001": "아무리 봐도 이건\n해체 중으로는 안 보이는군.",
 "DT_Chapter_07|Subs_C085|L_002": "SOD가 핵잠수함까지 갖고 있다니…",
 "DT_Chapter_07|Subs_C085|L_003": "그래.",
 "DT_Chapter_07|Subs_C085|L_004": "이것들을 전부 없애야겠군.",
 "DT_Chapter_07|Subs_C090|L_003": "선체 바로 밑에 어뢰를 밀어 넣어!",
 "DT_Chapter_07|Subs_C090|L_004": "적이다!",
 "DT_Chapter_07|Subs_C090|L_005": "이런!",
 "DT_Chapter_07|Subs_C100|L_001": "대위! 아이반! 서둘러!",
 "DT_Chapter_07|Subs_C100|L_002": "적이 다가오고 있어!",
 "DT_Chapter_07|Subs_C110|L_001": "서둘러! 어서! 가자!",
 "DT_Chapter_07|Subs_C110|L_002": "스텔라!",
 "DT_Chapter_07|Subs_C110|L_003": "제압 사격!",
 "DT_Chapter_07|Subs_C110|L_005": "이러다 우리 팀이 전멸한다.\n섬을 빠져나갈 다른 방법이 분명 있을 거야!",
 "DT_Chapter_07|Subs_C110|L_006": "IL-2는 어떻습니까?",
 "DT_Chapter_07|Subs_C110|L_007": "그 비행기가 멀쩡해도 2인승이야.",
 "DT_Chapter_07|Subs_C110|L_008": "제군들!\n소령은 아이반과 목표로 간다.\n우리는 여기 남아 적을 막는다.",
 "DT_Chapter_07|Subs_C110|L_009": "알겠습니다!",
 "DT_Chapter_07|Subs_C110|L_010": "알겠습니다!",
 "DT_Chapter_07|Subs_C110|L_011": "알겠습니다!",
 "DT_Chapter_07|Subs_C110|L_012": "대위!",
 "DT_Chapter_07|Subs_C110|L_013": "이게 임무입니다, 소령님.",
 "DT_Chapter_07|Subs_C110|L_014": "제 엔지니어를 데려가서 저 비행기를 띄우십시오.",
 "DT_Chapter_07|Subs_C110|L_015": "받아.",
 "DT_Chapter_07|Subs_C110|L_016": "내 부적이지만, 앞장서는 건 너다!\n나보다 너한테 더 필요할 거다!",
 "DT_Chapter_07|Subs_C110|L_017": "진심이야?",
 "DT_Chapter_07|Subs_C110|L_018": "엄호 사격!",
 "DT_Chapter_07|Subs_R010|L_001": "적이 못 다가오게 해!",
 "DT_Chapter_07|Subs_R010|L_002": "저기, 증원이다!",
 "DT_Chapter_07|Subs_R010|L_003": "2층이다!",
 "DT_Chapter_07|Subs_R010|L_004": "클리어!",
 "DT_Chapter_07|Subs_R010|L_005": "클리어!",
 "DT_Chapter_07|Subs_R010|L_006": "대위님! 괜찮습니까?",
 "DT_Chapter_07|Subs_R010|L_007": "그래, 계속 가자.",
 "DT_Chapter_07|Subs_R010|L_008": "아이반, 잠깐.\n대위님은 치료부터 받아야 해.",
 "DT_Chapter_07|Subs_R010|L_009": "어이, 대위님을 두고 갈 생각이야?",
 "DT_Chapter_07|Subs_R010|L_010": "대위님, 꼴이 말이 아닌데요.",
 "DT_Chapter_07|Subs_R010|L_011": "으, 그래도 기분은 최고다.",
 "DT_Chapter_07|Subs_R010|L_012": "안으로 들어가자.\n대위님 치료가 필요해.",
 "DT_Chapter_07|Subs_R020|L_001": "얼마나 더 걸려?",
 "DT_Chapter_07|Subs_R020|L_002": "글쎄다.",
 "DT_Chapter_07|Subs_R020|L_003": "서둘러! 시간이 없어.",
 "DT_Chapter_07|Subs_R020|L_004": "위쪽 RPG를 박살 내!",
 "DT_Chapter_07|Subs_R020|L_005": "거의 다 됐어.",
 "DT_Chapter_07|Subs_R020|L_006": "됐다!",
 "DT_Chapter_07|Subs_R030|L_001": "여기로 빠져나갈 수 있어.",
 "DT_Chapter_07|Subs_R040|L_001": "빨리 해.",
 "DT_Chapter_07|Subs_R040|L_002": "서둘러!",
 "DT_Chapter_07|Subs_R040|L_003": "폭약 설치 완료. 이동한다.",
 "DT_Chapter_07|Subs_R050|L_001": "위다! 엄폐해!",
 "DT_Chapter_07|Subs_R050|L_002": "적 다수 발견! 엄폐해!",
 "DT_Chapter_07|Subs_R050|L_003": "타워에 스나이퍼가 있다!\n제거해!",
 "DT_Chapter_07|Subs_R050|L_004": "발코니에 스나이퍼.",
 "DT_Chapter_07|Subs_R060|L_001": "정문이 잠겨 있다.",
 "DT_Chapter_07|Subs_R060|L_002": "폭약을 설치하고 물러서.",
 "DT_Chapter_07|Subs_R060|L_003": "좋아, 전진!",
 "DT_Chapter_07|Subs_R060|L_004": "게이트에 C4 폭약을 설치해!",
 "DT_Chapter_07|Subs_R060|L_005": "좋아, 이제 안전한 거리로 물러나.",
 "DT_Chapter_07|Subs_R070|L_001": "가자.",
 "DT_Chapter_07|Subs_R070|L_003": "오오, 잘 쐈어!",
 "DT_Chapter_07|Subs_R080|L_001": "젠장! 저건 괴물이야!",
 "DT_Chapter_07|Subs_R080|L_002": "머리 내밀지 마!",
 "DT_Chapter_07|Subs_R080|L_003": "헬기가 또 온다.",
 "DT_Chapter_07|Subs_R080|L_004": "엄폐해!",
 "DT_Chapter_07|Subs_R080|L_005": "사격이 멈추면 움직여!",
 "DT_Chapter_07|Subs_R080|L_006": "지금이다! 가!",
 "DT_Chapter_07|Subs_R090|L_001": "저 녀석들, 아직도 이렇게 병력이 많다니!",
 "DT_Chapter_07|Subs_R090|L_002": "뿔뿔이 흩어진 줄 알았는데.",
 "DT_Chapter_07|Subs_R090|L_003": "통째로 여기 있는 것 같군.\n그만큼 여기가 중요한 거겠지.",
 "DT_Chapter_07|Subs_R090|L_004": "아니면 악당 총회라도 열렸나 보지!",
 "DT_Chapter_07|Subs_R100|L_001": "이 배들은…",
 "DT_Chapter_07|Subs_R100|L_002": "…한참 전에 버려진 모양이군.",
 "DT_Chapter_07|Subs_R100|L_003": "헬기입니다!",
 "DT_Chapter_07|Subs_R110|L_001": "광학 위장이다.",
 "DT_Chapter_07|Subs_R110|L_002": "어디야? 어디 있어!",
 "DT_Chapter_07|Subs_R110|L_003": "예광탄을 잘 봐!",
 "DT_Chapter_07|Subs_R110|L_004": "보려고는 하는데 눈이 아파 죽겠어.",
 "DT_Chapter_07|Subs_R110|L_005": "보였다!",
 "DT_Chapter_07|Subs_R110|L_006": "어디 숨었니, 나와라~",
 "DT_Chapter_07|Subs_R110|L_007": "이 근처 어딘가에 있다.",
 "DT_Chapter_07|Subs_R110|L_008": "어디 있는 거야?",
 "DT_Chapter_07|Subs_R110|L_009": "사각을 잘 확인해. 적이 숨어 있어.",
 "DT_Chapter_07|Subs_R110|L_010": "제기랄, 엉망이군!",
 "DT_Chapter_07|Subs_R110|L_011": "올 클리어… 아마도요.",
 "DT_Chapter_07|Subs_R110|L_012": "좋아, 배 옆구리 구멍으로 빠져나간다.",
 "DT_Chapter_07|Subs_R120|L_001": "또 시작이군!",
 "DT_Chapter_07|Subs_R120|L_002": "여기서 뛰어내려!",
 "DT_Chapter_07|Subs_R130|L_001": "조심해. 숨어 있을지도 모른다.",
 "DT_Chapter_07|Subs_R130|L_002": "저기 있다!",
 "DT_Chapter_07|Subs_R130|L_003": "클리어!",
 "DT_Chapter_07|Subs_R130|L_004": "좋아, 들어간다.",
 "DT_Chapter_07|Subs_R140|L_001": "좋아, 폭탄 설치 완료.\n가자.",
 "DT_Chapter_07|Subs_R150|L_001": "녀석들, 정말로 전쟁을 시작할 생각인가?!",
 "DT_Chapter_07|Subs_R150|L_002": "그럴지도.",
 "DT_Chapter_07|Subs_R160|L_001": "아이반, 이쪽이다!",
 "DT_Chapter_07|Subs_R170|L_001": "또 나왔군!\n겁도 없는 녀석들이다.",
 "DT_Chapter_07|Subs_R170|L_002": "지독한 녀석들이네요.",
 "DT_Chapter_07|Subs_R170|L_003": "아이반, 엄호해 줘!",
 "DT_Chapter_07|Subs_R170|L_004": "찾았다! 3시 방향!",
 "DT_Chapter_07|Subs_R170|L_005": "폭약 설치 완료!",
 "DT_Chapter_07|Subs_R170|L_006": "조심해!",
 "DT_Chapter_07|Subs_R170|L_007": "여긴 끝났다. 가자!",
 "DT_Chapter_07|Subs_R170|L_008": "크레인에 적.",
 "DT_Chapter_07|Subs_R170|L_009": "갠트리 크레인 조종 장치 찾았어.\n가자!",
 "DT_Chapter_07|Subs_R170|L_010": "조심해!",
 "DT_Chapter_07|Subs_R170|L_011": "이 녀석들, 우리만 맞히면\n뭘 부숴도 상관없나 봐!",
 "DT_Chapter_07|Subs_R170|L_012": "미쳤어!",
 "DT_Chapter_07|Subs_R180|L_001": "좋아, 가! 가!",
 "DT_Chapter_07|Subs_R180|L_002": "서둘러! 시간이 없다!",
 "DT_Chapter_07|Telops|Chapter7Time_a": "현지 시간 11월 11일 15:30",
 "DT_Chapter_07|Telops|Chapter7Place_a": "브라트 후지 서쪽 사면\n툰드라 고개",
 "DT_Chapter_07_Mg1|Subs_Set01|L_001": "게이트가 길을 막고 있어!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_002": "뚫고 나가!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_003": "라저!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_004": "이봐, 터널은 파괴하지 마!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_005": "이런!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_006": "앞을 봐!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_007": "가! 가! 가! 서둘러!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_008": "앞에 바리케이드.",
 "DT_Chapter_07_Mg1|Subs_Set01|L_009": "밟아! 뚫고 나간다!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_011": "간신히 돌파한 모양이군.",
 "DT_Chapter_07_Mg1|Subs_Set01|L_012": "적이 옵니다!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_013": "젠장, 헌터다.\n풀 오토 런처를 써!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_014": "알겠습니다!",
 "DT_Chapter_07_Mg1|Subs_Set01|L_015": "골칫거리 헬기 하나 줄었다!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_001": "됐다!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_002": "밟아! 조준선에서 벗어나!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_003": "무슨 일이 있어도 속도 줄이지 마!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_004": "RPG 날아온다!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_005": "피해!",
 "DT_Chapter_07_Mg1|Subs_Set02|L_006": "위험해!",
 "DT_Chapter_07_Mg1|Subs_Set03|L_001": "조심해!",
 "DT_Chapter_07_Mg1|Subs_Set03|L_002": "충격에 대비해!",
 "DT_Chapter_07_Mg1|Subs_Set03|L_003": "다들 괜찮나?!",
 "DT_Chapter_07_Mg1|Subs_Set03|L_004": "괜찮습니다.",
 "DT_Chapter_07_Mg1|Subs_Set04|L_001": "게이트가 닫혀 있습니다!",
 "DT_Chapter_07_Mg1|Subs_Set04|L_002": "들이받아!",
 "DT_Chapter_07_Mg1|Subs_Set05|L_001": "6시 방향에 적!",
 "DT_Chapter_07_Mg1|Subs_Set05|L_002": "뒤처지지 마!",
 "DT_Chapter_07_Mg1|Subs_Set05|L_003": "놓치지 마!",
 "DT_Chapter_07_Mg1|Subs_Set05|L_004": "뒤처지고 있다! 밟아!",
 "DT_Chapter_07_Mg1|Subs_Set05|L_005": "더 붙어서 달려!",
 "DT_Chapter_07_Mg1|Subs_Set06|L_001": "우왓, 치킨 게임 하자고?",
 "DT_Chapter_07_Mg1|Subs_Set06|L_002": "본때를 보여 줘, 아이반!",
 "DT_Chapter_07_Mg1|Subs_Set06|L_003": "그거다!",
 "DT_Chapter_07_Mg1|Subs_Set07|L_002": "괜찮습니까?! 대위님!",
 "DT_Chapter_07_Mg1|Subs_Set07|L_003": "그래, 스친 것뿐이다.",
 "DT_Chapter_07_Mg1|Subs_Set08|L_001": "위험해!",
 "DT_Chapter_07_Mg1|Subs_Set08|L_002": "젠장!",
 "DT_Chapter_07_Mg1|Subs_Set09|L_001": "로켓이 날아와!\n최대한 빨리 낙하 예측 지점을 보낼게.",
 "DT_Chapter_07_Mg1|Subs_Set09|L_002": "온다!",
 "DT_Chapter_07_Mg1|Subs_Set09|L_004": "아이반, 부탁한다!",
 "DT_Chapter_07_Mg1|Subs_Set09|L_005": "로켓에 다리가 날아갔습니다!",
 "DT_Chapter_07_Mg1|Subs_Set09|L_006": "멈추지 마!",
 "DT_Chapter_07_Mg1|Subs_Set10|L_001": "아슬아슬했어!",
 "DT_Chapter_07_Mg1|Subs_Set10|L_002": "그 기세다, 아이반!",
 "DT_Chapter_07_Mg1|Subs_Set10|L_003": "이제 끝장인 줄 알았네.",
 "DT_Chapter_07_Mg1|Subs_Set10|L_004": "넌 때가 되면 지옥행 화물열차 직행이다.",
 "DT_Chapter_07_Mg1|Subs_Set10|L_005": "젠장!",
 "DT_Chapter_07_Mg1|Subs_Set10|L_006": "안 돼에!",
 "DT_Chapter_07_Mg1|Subs_Set10|L_007": "세상에!",
 "DT_Chapter_07_Mg1|Subs_Set11|L_001": "방심하지 마! 공격받고 있어!",
 "DT_Chapter_07_Mg1|Subs_Set11|L_002": "멈춘 것 같습니다.",
 "DT_Chapter_07_Mg1|Subs_Set11|L_003": "여기선 미사일이 못 닿는다!",
 "DT_Chapter_07_Mg1|Subs_Set11|L_004": "이 틈에 서두릅시다!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_001": "적 헬기 접근!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_002": "관광하러 온 게 아니라고!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_003": "12시 상공에 적!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_004": "조심하세요, 적이 또 있습니다.",
 "DT_Chapter_07_Mg1|Subs_Set12|L_005": "미사일 날아온다!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_006": "피해!",
 "DT_Chapter_07_Mg1|Subs_Set12|L_007": "미사일 또 옵니다!",
 "DT_Chapter_07_Mg1|Subs_Set13|L_001": "낙석 조심해!",
 "DT_Chapter_07_Mg1|Subs_Set13|L_002": "조심해!",
 "DT_Chapter_07_Mg1|Subs_Set13|L_003": "뒤를 조심해!",
 "DT_Chapter_07_Mg1|Subs_Set14|L_001": "눈사태다!",
 "DT_Chapter_07_Mg1|Subs_Set14|L_002": "씨발, 좆됐다!",
 "DT_Chapter_07_Mg1|Subs_Set14|L_003": "터널로 들어가!",
 "DT_Chapter_07_Mg1|Subs_Set14|L_008": "서둘러, 아이반!",
 "DT_Chapter_07_Mg1|Subs_Set15|L_001": "진짜 아슬아슬했어!",
 "DT_Chapter_07_Mg1|Subs_Set15|L_002": "기지까지 돌파한다!"
}